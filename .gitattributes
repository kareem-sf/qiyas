# Text files are stored and checked out with LF line endings on every OS.
* text=auto eol=lf

# Licence texts stay byte for byte as their authors wrote them.
LICENSE -text
LICENSES/*.txt -text

# Binary: drawings, spreadsheets, PDFs, plot styles, images and fonts.
*.dwg binary
*.dxf binary
*.xlsx binary
*.pdf binary
*.ctb binary
*.stb binary
*.png binary
*.ico binary
*.icns binary
*.ttf binary
*.otf binary
*.woff2 binary
